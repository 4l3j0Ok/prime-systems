    {
      "id": "mRR-VF45KichSzYD4bPXT",
      "type": "text",
      "x": 4980,
      "y": 240,
      "width": 545.5999755859375,
      "height": 140,
      "angle": 0,
      "strokeColor": "#1e1e1e",
