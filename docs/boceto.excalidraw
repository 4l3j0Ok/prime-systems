    {
      "id": "M-R3gie4dk_aaVsSKmaUo",
      "type": "text",
      "x": 6120,
      "y": 240,
      "width": 545.5999755859375,
      "height": 140,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#1e1e1e",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": "iXUn4bpUu2dRWxt03Gkrw",
      "index": "bJ5",
      "roundness": null,
      "seed": 492407717,
      "version": 109,
      "versionNonce": 117860443,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1756244902619,
      "link": null,
      "locked": false,
      "text": "Idem LOOK, pero restringe la atención en un solo sentido. Al\nllegar al último requerimiento vuelve al menor requerimiento y\ncomienza a barrer nuevamente.\nEjemplo: Cantidad de Pistas: 200 (0..199).\n• Requerimientos en la cola: {98 , 183 , 37, 122, 14, 124, 65,\n67}\n• Ubicación actual de la cabeza: Pista 53 (Viene del 61)",
      "fontSize": 16,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Idem LOOK, pero restringe la atención en un solo sentido. Al\nllegar al último requerimiento vuelve al menor requerimiento y\ncomienza a barrer nuevamente.\nEjemplo: Cantidad de Pistas: 200 (0..199).\n• Requerimientos en la cola: {98 , 183 , 37, 122, 14, 124, 65,\n67}\n• Ubicación actual de la cabeza: Pista 53 (Viene del 61)",
      "autoResize": true,
      "lineHeight": 1.25
    },
