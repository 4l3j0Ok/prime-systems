      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": "L8F2vf4V61Ju9doZtABrg",
      "index": "bIU",
      "roundness": null,
      "seed": 2016796357,
      "version": 84,
      "versionNonce": 321161397,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1756244902619,
      "link": null,
      "locked": false,
      "text": "Idem SCAN, pero restringe la atención en un solo sentido. Al\nllegar a la última pista (o último requerimiento) vuelve a la\nprimer pista y comienza a barrer nuevamente.\n• Ejemplo: Cantidad de Pistas: 200 (0..199).\n• Requerimientos en la cola: {98 , 183 , 37, 122, 14, 124, 65,\n67}\n• Ubicación actual de la cabeza: Pista 53 (Viene del 61)",
      "fontSize": 16,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Idem SCAN, pero restringe la atención en un solo sentido. Al\nllegar a la última pista (o último requerimiento) vuelve a la\nprimer pista y comienza a barrer nuevamente.\n• Ejemplo: Cantidad de Pistas: 200 (0..199).\n• Requerimientos en la cola: {98 , 183 , 37, 122, 14, 124, 65,\n67}\n• Ubicación actual de la cabeza: Pista 53 (Viene del 61)",
      "autoResize": true,
      "lineHeight": 1.25
    },
